# KindleHermes Configuration (Paperwhite 10th Gen — 1072x1448 @ 300 PPI)

# Server
HOST=0.0.0.0
PORT=8000
TIMEZONE=Europe/Berlin

# Optional Access Token / PIN for hosting online (leave blank for open local dev)
# When set, /app asks for this PIN and Kindle URLs pass ?token=YOUR_TOKEN
HERMES_TOKEN=

# Default data mode: true = start with rich mock data out of the box, false = live feeds
USE_MOCK_DATA=true

# Calendar (.ics URL from Google Calendar, Apple Calendar, Fastmail, etc.)
CALENDAR_ICS_URL=

# Weather (Open-Meteo — no API key needed)
WEATHER_CITY=Berlin
WEATHER_LAT=52.52
WEATHER_LON=13.405

# Google Gemini API (optional — uses clean editorial mock briefing when unset)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_USE_SEARCH_GROUNDING=false

# Google Calendar OAuth2 (connect all your Google Calendars in /app)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; auto-detected from request origin (e.g. http://localhost:8000/api/google/callback)
GOOGLE_REDIRECT_URI=

# Optional: Custom Chromium executable path for /render.png (auto-detects Chrome/Playwright if blank)
CHROMIUM_EXECUTABLE_PATH=
